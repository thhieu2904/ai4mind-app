# Dockerfile.render - Optimized for Render 512MB build limit
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install ONLY essential system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies with optimizations
# --no-cache-dir: Don't cache packages (saves RAM)
# --compile: Compile .pyc files after install (not during)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application
COPY . .

# Create storage directory
RUN mkdir -p storage/audio/temp

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8001/health')"

# Run application with memory optimization
# --workers 1: Single worker process
# --limit-concurrency 1: Process one request at a time (prevents memory spikes)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--limit-concurrency", "1"]
